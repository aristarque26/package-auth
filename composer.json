{
    "name": "taibi/auth-api",
    "description": "Package d'authentification reutilisable pour Laravel avec gestion des roles, OTP et verification email",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "authentication", "sanctum", "api", "roles", "otp"],
    "authors": [
        {
            "name": "Taibi",
            "email": "taibi@example.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^10.0|^11.0|^12.0",
        "laravel/sanctum": "^3.3|^4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Taibi\\AuthAPI\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Taibi\\AuthAPI\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Taibi\\AuthAPI\\AuthServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}